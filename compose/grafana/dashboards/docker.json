    {"id": 2, "type": "stat", "title": "CPU dos containers", "gridPos": {"h": 5, "w": 6, "x": 6, "y": 0}, "targets": [{"expr": "sum(rate(container_cpu_usage_seconds_total{name!=\"\"}[5m])) * 100"}], "fieldConfig": {"defaults": {"unit": "percent"}}},
    {"id": 3, "type": "stat", "title": "Memória dos containers", "gridPos": {"h": 5, "w": 6, "x": 12, "y": 0}, "targets": [{"expr": "sum(container_memory_usage_bytes{name!=\"\"})"}], "fieldConfig": {"defaults": {"unit": "bytes"}}},
